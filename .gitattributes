# Ignore web/edge runtime, playground UI, and build outputs from statistics
src/** linguist-vendored
src/** linguist-documentation
functions/** linguist-vendored
functions/** linguist-documentation
dist/** linguist-vendored
dist/** linguist-documentation
public/** linguist-vendored
public/** linguist-documentation
tests/** linguist-vendored
tests/** linguist-documentation
*.ts linguist-vendored
*.ts -linguist-detectable
*.js linguist-vendored
*.js -linguist-detectable
*.html linguist-vendored
*.html -linguist-detectable
*.css linguist-vendored
*.css -linguist-detectable
package.json linguist-vendored
package-lock.json linguist-vendored
tsconfig.json linguist-vendored

# Canonical curriculum languages
python/** linguist-detectable
sql/** linguist-detectable
*.py linguist-detectable
*.sql linguist-detectable

# Tout le TS/JS/HTML/CSS et dossiers générés sont exclus des stats
**/*.ts linguist-vendored=true
**/*.tsx linguist-vendored=true
**/*.js linguist-vendored=true
**/*.mjs linguist-vendored=true
**/*.html linguist-vendored=true
**/*.css linguist-vendored=true
tests/** linguist-vendored=true
.wrangler/** linguist-generated=true
